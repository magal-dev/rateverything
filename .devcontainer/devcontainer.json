{
  "name": "Rateverything (Haskell + PostgreSQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",

  "postCreateCommand": "cabal update && cabal build rateverything",

  "forwardPorts": [8080, 5432],
  "portsAttributes": {
    "8080": { "label": "Rateverything", "onAutoForward": "openBrowser" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  "secrets": {
    "TMDB_API_KEY": {
      "description": "Chave v3 do TMDB (busca de filmes e séries)",
      "documentationUrl": "https://www.themoviedb.org/settings/api"
    },
    "RAWG_API_KEY": {
      "description": "Chave da RAWG (busca de jogos)",
      "documentationUrl": "https://rawg.io/apidocs"
    },
    "MUSICBRAINZ_USER_AGENT": {
      "description": "User-Agent com contato exigido pelo MusicBrainz, ex.: Rateverything/0.1 ( voce@exemplo.com )",
      "documentationUrl": "https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "justusadam.language-haskell",
        "ckolkman.vscode-postgres"
      ]
    }
  }
}
