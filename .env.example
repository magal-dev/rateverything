# Copie para .env e preencha. Variáveis já definidas no ambiente têm prioridade.
PORT=8080
DB_PATH=rateverything.db
UPLOAD_DIR=uploads
STATIC_DIR=static

# Filmes e séries — https://www.themoviedb.org/settings/api (chave v3)
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR

# Jogos — https://rawg.io/apidocs
RAWG_API_KEY=

# MusicBrainz exige um User-Agent identificável com contato
MUSICBRAINZ_USER_AGENT=Rateverything/0.1 ( seu-email@exemplo.com )
